# Set these as server-side Vercel environment variables (never NEXT_PUBLIC_).
# Inquiry notifications use Tencent SES and the verified notify.yidaolife.com sender.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# Public contact email and notification recipient are defined in src/lib/inquiry.ts.
# Connect a PRIVATE Vercel Blob store. On Vercel prefer its managed BLOB_STORE_ID/OIDC connection.
# For local or token-based use, configure the private store token here.
BLOB_READ_WRITE_TOKEN=
# Optional separate long random secret. TENCENTCLOUD_SECRET_KEY is used if absent.
INQUIRY_SIGNING_SECRET=
# Only needed for an explicit Vercel preview origin or local production test.
INQUIRY_ALLOWED_ORIGIN=
