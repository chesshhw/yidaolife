# Set these as server-side Vercel environment variables (never NEXT_PUBLIC_).
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=13512456138@163.com
# 163 SMTP application authorization code, NOT your account password.
SMTP_PASS=
# Optional separate long random secret. SMTP_PASS is used if absent.
INQUIRY_SIGNING_SECRET=
# Only needed for an explicit Vercel preview origin or local production test.
INQUIRY_ALLOWED_ORIGIN=
